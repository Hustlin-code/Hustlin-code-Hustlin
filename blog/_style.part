<style>
  .post-hero .hero-h1{font-family:var(--f-body);font-weight:800;letter-spacing:-.01em;-webkit-text-stroke:0;text-shadow:none}
  .post-hero .hero-h1 em{font-style:normal;color:var(--amber);-webkit-text-stroke:0;text-shadow:none}
  .pw{max-width:760px;margin:0 auto;padding:0 24px}
  .pw h2{font-family:var(--f-body);font-size:1.45rem;font-weight:800;color:#fff;margin:44px 0 14px;letter-spacing:-.01em}
  .pw h3{font-family:var(--f-body);font-size:1rem;font-weight:700;color:var(--amber);margin:26px 0 10px}
  .pw p{font-family:var(--f-body);font-size:1rem;line-height:1.78;color:rgba(255,255,255,.64);margin:0 0 16px}
  .pw p strong{color:rgba(255,255,255,.92)}
  .pw a{color:var(--amber);text-decoration:none}
  .pw a:hover{text-decoration:underline}
  .pw ul{list-style:none;padding:0;margin:0 0 18px}
  .pw ul li{font-family:var(--f-body);font-size:.97rem;line-height:1.72;color:rgba(255,255,255,.64);padding:0 0 0 26px;margin-bottom:11px;position:relative}
  .pw ul li:before{content:"→";position:absolute;left:0;color:var(--amber);font-weight:700}
  .pw ol{padding-left:20px;margin:0 0 18px}
  .pw ol li{font-family:var(--f-body);font-size:.97rem;line-height:1.72;color:rgba(255,255,255,.64);margin-bottom:12px;padding-left:6px}
  .pbox{border:1px solid rgba(245,197,32,.28);background:rgba(245,197,32,.05);border-radius:12px;padding:20px 22px;margin:0 0 20px}
  .pbox .pt{font-family:var(--f-body);font-size:.7rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--amber);display:block;margin-bottom:9px}
  .pbox p{margin:0;color:rgba(255,255,255,.72);font-size:.95rem}
  .pwarn{border-color:rgba(255,120,80,.35);background:rgba(255,120,80,.06)}
  .pwarn .pt{color:#ff8a5c}
  .pmeta{font-family:var(--f-mono,'Space Mono',monospace);font-size:.74rem;color:rgba(255,255,255,.34);margin-bottom:26px}
  .pnext{border-top:1px solid rgba(255,255,255,.09);margin-top:48px;padding-top:28px}
  table.ptab{width:100%;border-collapse:collapse;margin:0 0 20px;font-family:var(--f-body);font-size:.9rem}
  table.ptab th{text-align:left;padding:10px 12px;color:var(--amber);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid rgba(245,197,32,.25)}
  table.ptab td{padding:11px 12px;color:rgba(255,255,255,.62);border-bottom:1px solid rgba(255,255,255,.07);line-height:1.55}
</style>